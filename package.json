{
  "name": "canvas-export-proof",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:site": "vite --config site/vite.config.ts",
    "build:extension": "wxt build",
    "package:extension": "node scripts/package-extension.mjs",
    "build:site": "vite build --config site/vite.config.ts",
    "build": "npm run build:extension && npm run package:extension && npm run build:site",
    "test": "vitest run",
    "test:response-policy": "node scripts/verify-response-policy.mjs",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "check": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/chrome": "^0.0.322",
    "adm-zip": "^0.5.16",
    "sharp": "^0.34.2",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.1.4",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "pdfjs-dist": "^6.2.108"
  }
}
